{
  "name": "react-mobile-scrollbar",
  "version": "1.0.2",
  "private": false,
  "description": "A mobile-like scrollbar on desktop and then just use default scrollbar on touchable devices.",
  "author": "karanokara <karawakara@gmail.com> (https://github.com/karanokara)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karanokara/react-mobile-scrollbar.git"
  },
  "homepage": "https://karanokara.github.io/react-mobile-scrollbar",
  "keywords": [
    "react",
    "scrollbar",
    "auto disappear",
    "mobile scrollbar",
    "mobile",
    "react scrollbar",
    "custom scrollbar"
  ],
  "source": "src/index.ts",
  "main": "dist/index.js",
  "module": "dist/index.module.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf ./dist && rollup -c",
    "start": "cd ./demo && npm start",
    "d": "cd ./demo && npm run deploy",
    "p": "npm run build && npm publish",
    "pd": "npm run p && npm run d"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^15.0.2",
    "@rollup/plugin-terser": "^0.4.1",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^16.18.23",
    "@types/react": "^18.0.34",
    "@types/react-dom": "^18.0.11",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "rollup": "^4.64.5",
    "rollup-plugin-import-css": "^3.2.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-scss": "^4.0.0",
    "sass": "^1.105.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": ">=16.8",
    "react-dom": ">=16.8"
  }
}
